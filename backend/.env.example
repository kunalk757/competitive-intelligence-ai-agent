# Environment variables template for Competitive Intelligence Agent Backend

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Provider (Gemini API) - To be populated in subsequent steps
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL Configuration - To be populated in subsequent steps
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here
