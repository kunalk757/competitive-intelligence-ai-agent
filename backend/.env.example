# Environment variables template for Competitive Intelligence Agent Backend

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Provider (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# GNews API Configuration (Backend-Only)
GNEWS_API_KEY=your_gnews_api_key_here

# Tavily API Configuration (Backend-Only)
TAVILY_API_KEY=your_tavily_api_key_here

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# Optional: Cloud Cron Webhook Secret for /api/news/refresh
CRON_SECRET=your_optional_cloud_cron_secret_token
